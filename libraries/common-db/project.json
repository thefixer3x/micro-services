{
    "name": "@platform/common-db",
    "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/micro-services/libraries/common-db/src",
    "projectType": "library",
    "tags": [
        "scope:libraries",
        "type:database"
    ],
    "targets": {
        "build": {
            "executor": "@nx/js:tsc",
            "outputs": [
                "{options.outputPath}"
            ],
            "options": {
                "outputPath": "dist/apps/micro-services/libraries/common-db",
                "main": "apps/micro-services/libraries/common-db/src/index.ts",
                "tsConfig": "apps/micro-services/libraries/common-db/tsconfig.lib.json",
                "assets": [
                    "apps/micro-services/libraries/common-db/*.md"
                ]
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "options": {
                "lintFilePatterns": [
                    "apps/micro-services/libraries/common-db/**/*.ts"
                ]
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": [
                "{workspaceRoot}/coverage/{projectRoot}"
            ],
            "options": {
                "jestConfig": "apps/micro-services/libraries/common-db/jest.config.js",
                "passWithNoTests": true
            }
        }
    }
}