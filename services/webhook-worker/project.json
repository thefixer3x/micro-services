{
    "name": "@seftec/webhook-worker",
    "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/micro-services/services/webhook-worker/src",
    "projectType": "application",
    "tags": [
        "scope:services",
        "type:worker"
    ],
    "targets": {
        "build": {
            "executor": "@nx/js:tsc",
            "outputs": [
                "{options.outputPath}"
            ],
            "options": {
                "outputPath": "dist/apps/micro-services/services/webhook-worker",
                "main": "apps/micro-services/services/webhook-worker/src/index.ts",
                "tsConfig": "apps/micro-services/services/webhook-worker/tsconfig.json",
                "assets": [
                    "apps/micro-services/services/webhook-worker/*.md"
                ]
            }
        },
        "serve": {
            "executor": "@nx/js:node",
            "options": {
                "buildTarget": "@seftec/webhook-worker:build"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "options": {
                "lintFilePatterns": [
                    "apps/micro-services/services/webhook-worker/**/*.ts"
                ]
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": [
                "{workspaceRoot}/coverage/{projectRoot}"
            ],
            "options": {
                "jestConfig": "apps/micro-services/services/webhook-worker/jest.config.js",
                "passWithNoTests": true
            }
        }
    }
}