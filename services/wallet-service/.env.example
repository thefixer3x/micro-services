# Server Configuration
NODE_ENV=development
PORT=3002
HOST=localhost

# Environment Toggle (dev | staging | production)
DATABASE_ENV=dev

# Neon Configuration (Dev/Test)
NEON_DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require
NEON_ANON_KEY=your-neon-anon-key
NEON_SERVICE_ROLE_KEY=your-neon-service-role-key

# Supabase Configuration (Production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Redis Configuration (for caching and session management)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Default Wallet Provider
DEFAULT_WALLET_PROVIDER=providus

# Providus Bank (Xpress Wallet) Configuration
PROVIDUS_BASE_URL=https://api.xpresswallet.com
PROVIDUS_SANDBOX_URL=https://sandbox.api.xpresswallet.com
PROVIDUS_API_KEY=your-providus-api-key
PROVIDUS_CLIENT_ID=your-client-id
PROVIDUS_CLIENT_SECRET=your-client-secret
PROVIDUS_USE_SANDBOX=true

# Flutterwave Configuration (Future)
# FLUTTERWAVE_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_ENCRYPTION_KEY=

# Paystack Configuration (Future)
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/wallet-service.log

# Service URLs (for inter-service communication)
IDENTITY_SERVICE_URL=http://localhost:3001
TRANSACTION_SERVICE_URL=http://localhost:3003
