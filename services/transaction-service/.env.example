# Server Configuration
PORT=3003
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/transaction_db

# Redis (for caching and rate limiting)
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=transaction-service
KAFKA_GROUP_ID=transaction-service-group

# Internal Services
IDENTITY_SERVICE_URL=http://localhost:3001
WALLET_SERVICE_URL=http://localhost:3002

# Exchange Rate Provider
EXCHANGE_RATE_API_URL=https://api.exchangerate.host
EXCHANGE_RATE_API_KEY=

# Transaction Limits
MAX_DOMESTIC_TRANSFER=1000000
MAX_INTERNATIONAL_TRANSFER=500000
DAILY_TRANSFER_LIMIT=2000000

# Fee Configuration
DOMESTIC_FEE_PERCENTAGE=0.5
INTERNATIONAL_FEE_PERCENTAGE=1.5
MINIMUM_FEE=100

# Security
HMAC_SECRET=your-hmac-secret-key
